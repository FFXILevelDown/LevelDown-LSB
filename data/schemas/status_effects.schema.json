{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "status_effects.schema.json",
   "title": "Status Effects",
   "description": "Status effects and their overwrite, block, and removal rules.",
   "type": "object",
   "properties": {
      "status_effects": {
         "type": "object",
         "additionalProperties": {
            "type": "object",
            "properties": {
               "block": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/StatusEffect"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "This effect will not land while the named effect is active."
               },
               "element": {
                  "anyOf": [
                     {
                        "type": "string",
                        "title": "Element",
                        "enum": [
                           "none",
                           "fire",
                           "ice",
                           "wind",
                           "earth",
                           "thunder",
                           "water",
                           "light",
                           "dark"
                        ]
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "Element used for resistance checks."
               },
               "exclusion_group": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/StatusEffect"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "Applying this effect removes all other effects sharing the same group (the group's representative effect). For example, all spikes share blaze_spikes."
               },
               "flags": {
                  "anyOf": [
                     {
                        "type": "array",
                        "items": {
                           "type": "string",
                           "title": "StatusEffectFlag",
                           "enum": [
                              "none",
                              "dispelable",
                              "erasable",
                              "attack",
                              "empathy",
                              "damage",
                              "death",
                              "magic_begin",
                              "magic_end",
                              "on_zone",
                              "no_loss_message",
                              "invisible",
                              "detectable",
                              "no_rest",
                              "prevent_action",
                              "waltzable",
                              "food",
                              "song",
                              "roll",
                              "synth_support",
                              "confrontation",
                              "logout",
                              "bloodpact",
                              "on_jobchange",
                              "no_cancel",
                              "influence",
                              "offline_tick",
                              "aura",
                              "hide_timer",
                              "on_zone_pathos",
                              "always_expiring",
                              "on_attack"
                           ]
                        }
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "Behaviour flags. Defaults to an empty list; redefine the entire list when overriding.",
                  "uniqueItems": true
               },
               "id": {
                  "$ref": "#/$defs/uint16_t",
                  "description": "Client-facing status effect ID.",
                  "minimum": 0,
                  "maximum": 65535
               },
               "min_duration": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/uint16_t"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "Floor on the effect duration, in seconds.",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 65535
               },
               "name": {
                  "type": [
                     "string",
                     "null"
                  ],
                  "description": "Override for the Lua script lookup name. Defaults to the YAML key."
               },
               "negative": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/StatusEffect"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "This effect only lands if the named effect is weaker."
               },
               "overwrite": {
                  "anyOf": [
                     {
                        "type": "string",
                        "title": "EffectOverwrite",
                        "enum": [
                           "equal_higher",
                           "higher",
                           "never",
                           "always",
                           "ignore_duplicate",
                           "tier_higher"
                        ]
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "When this effect may replace another instance of itself."
               },
               "remove": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/StatusEffect"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "The named effect is always removed when this one lands."
               },
               "sort_key": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/uint16_t"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "Order in which the effect is displayed.",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 65535
               },
               "wear_off_message_id": {
                  "anyOf": [
                     {
                        "$ref": "#/$defs/uint16_t"
                     },
                     {
                        "type": "null"
                     }
                  ],
                  "description": "Message shown when the effect wears off.",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 65535
               }
            },
            "additionalProperties": false,
            "required": [
               "id"
            ]
         },
         "description": "Status effects keyed by their canonical name."
      },
      "meta": {
         "$ref": "_meta.schema.json"
      }
   },
